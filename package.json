{
  "name": "dinemate",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:student": "pnpm --filter student dev",
    "dev:console": "pnpm --filter console dev",
    "dev:console:api": "pnpm --filter console dev --mode api",
    "dev:business": "pnpm --filter business dev",
    "dev:business:api": "pnpm --filter business dev --mode api",
    "dev:api": "uv run --directory services/api uvicorn app.main:app --reload --port 8000",
    "test:api": "uv run --directory services/api pytest -q",
    "stack:up": "docker compose -f infra/docker-compose.yml up -d --build --wait",
    "stack:down": "docker compose -f infra/docker-compose.yml down",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "uv run --directory services/api python -m app.openapi_export ../../packages/api-client/openapi.json && pnpm --filter @dinemate/api-client gen",
    "dev:student:api": "pnpm --filter student dev --mode api",
    "e2e": "pnpm --filter @dinemate/e2e test",
    "screenshots": "pnpm --filter @dinemate/e2e screenshots"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
