POSTGRES_USER=dinemate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dinemate
POSTGRES_PORT=5432
API_PORT=8000
DINEMATE_ENVIRONMENT=development
DINEMATE_SIMULATION_MODE=true
DINEMATE_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
DINEMATE_SEED_IF_EMPTY=true
DINEMATE_SIMULATOR_INTERVAL_S=30
# Freeze the demo at a fixed moment (time keeps running from there). Leave empty for real time.
DINEMATE_DEMO_CLOCK_START=
# DINEMATE_DEMO_CLOCK_START=2026-11-20T12:41:18+05:30
DINEMATE_SIMULATOR_TOKEN=dev-simulator-token
# Signs staff access tokens. Use a long random value outside development.
DINEMATE_JWT_SECRET=dev-only-change-me-dinemate-jwt-secret
# Seeding creates demo staff accounts (admin@, canteen.a@, rice.stall@, safety@dinemate.test) with this password.
DINEMATE_DEMO_PASSWORD=dinemate-demo-pass
